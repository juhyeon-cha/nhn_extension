{
  "manifest_version": 3,
  "name": "업무 도우미",
  "version": "1.0",
  "description": "구내식당 메뉴 조회·알림, 퍼플 타임 일괄 조정, 회의실 예약표 개선·빈 회의실 반복 조회",
  "action": {
    "default_popup": "popup/frontend/index.html",
    "default_icon": {
      "16": "assets/port629_16.png",
      "32": "assets/port629_32.png",
      "48": "assets/port629_48.png",
      "128": "assets/port629_128.png"
    }
  },
  "options_page": "options/frontend/index.html",
  "permissions": [
    "storage",
    "alarms",
    "contextMenus",
    "activeTab",
    "scripting",
    "notifications"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://menu.payco.com/*"
      ],
      "js": [
        "content.js"
      ]
    },
    {
      "matches": [
        "*://nharmony.nhncorp.com/user/hrms/odm/attend/purpleTime.nhn*"
      ],
      "js": [
        "content-purple-time.js"
      ]
    },
    {
      "matches": [
        "https://pt.nhncorp.com/*"
      ],
      "js": [
        "room/model.js",
        "content-room.js"
      ],
      "css": [
        "content-room.css"
      ]
    }
  ]
}
